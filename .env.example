# Copy this file to .env.local and set values from your Supabase project's Connect panel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Optional: use this for email verification and password-reset links in deployed environments.
# For local testing, the action uses the origin of the current browser request.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
